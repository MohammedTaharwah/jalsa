# Environment Variables Template
# Copy this file to .env before starting the containers

COMPOSE_PROJECT_NAME=jalsah_platform

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password123
POSTGRES_DB=qna_platform_db
POSTGRES_PORT=5433
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_SSL_MODE=require

# Backend (FastAPI) Configuration
BACKEND_PORT=8000
JWT_SECRET_KEY=supersecretjwtkey_jalsah_2026_replace_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_URL=https://your-frontend-domain.example
CORS_ORIGINS=https://your-frontend-domain.example

# Frontend (React / Vite) Configuration
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000

# n8n AI Automation Configuration
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://n8n:5678/webhook/generate-questions
N8N_WEBHOOK_SECRET=jalsah_n8n_secret_token_2026
OPENAI_API_KEY=sk-your-openai-api-key

# Email delivery via Resend HTTPS API
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev
